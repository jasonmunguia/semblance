# Local development: uv run uvicorn semblance.api:create_app --factory --app-dir backend
SEMBLANCE_DATABASE_URL=sqlite:///./semblance.db
SEMBLANCE_ALCHEMY_KEY=
SEMBLANCE_SESSION_SECRET=local-development-only-change-before-deploy
SEMBLANCE_PRODUCTION=false
SEMBLANCE_MAX_WALLETS=3
SEMBLANCE_MAX_GLOBAL_WALLETS=3
SEMBLANCE_POLL_SECONDS=300
SEMBLANCE_SCAN_BLOCKS=300
SEMBLANCE_COLLECTOR_SECRET=
# Production must use PostgreSQL + a random session secret + HTTPS.
# Vercel's Neon integration supplies DATABASE_URL, read automatically.
